# 이 파일을 프로젝트 루트에 .env.local 이라는 이름의 "파일"로 복사해 값을 채우세요 (cp .env.example .env.local).
# .env.local 은 .gitignore 대상입니다. 실제 값, 특히 GITHUB_CLIENT_SECRET 은 이 파일에 적거나 커밋하지 마세요.

# MongoDB 연결 문자열 (일반 단일 노드 mongod 또는 Atlas 무료 티어 모두 가능, replica set 불필요)
MONGODB_URI=mongodb://127.0.0.1:27017/kanban-goal-todo

# "오늘"과 이번 주(월요일 시작)를 계산하는 기준 시간대. 기본값 Asia/Seoul
APP_TIMEZONE=Asia/Seoul

# --- GitHub OAuth 로그인 ---
# GitHub → Settings → Developer settings → OAuth Apps 에서 만든 앱의 Client ID
GITHUB_CLIENT_ID=
# 같은 앱의 Client secret. 절대 커밋하지 말고 .env.local 이나 배포 환경변수로만 설정하세요
GITHUB_CLIENT_SECRET=
# 앱의 외부 주소(끝에 / 없이). 콜백 URL = {APP_BASE_URL}/auth/github/callback 이며
# OAuth App 의 "Authorization callback URL" 과 정확히 같아야 합니다. 예) http://localhost:3000
# 프로덕션(NODE_ENV=production, npm start)에서는 https URL 만 허용됩니다.
APP_BASE_URL=
# 로그인 기능 도입 전에 만든(소유자 없는) 데이터를 넘겨받을 사용자의 GitHub 숫자 id (username 아님).
# 확인: https://api.github.com/users/<login> 응답의 "id" 값. 양의 정수가 아니면 무시하고 경고만 남깁니다.
# 이 사용자가 로그인하면 자동으로 귀속됩니다(멱등). 비워 두면 귀속하지 않고 경고만 남깁니다.
# 수동 실행: npm run migrate:owner -- <github-id>
# 귀속이 끝나면 이 변수를 삭제하세요.
LEGACY_OWNER_GITHUB_ID=

# (선택) 테스트용 모의 OAuth 서버 주소. 비워 두면 실제 GitHub 를 사용합니다 (프로덕션에서는 https 만 허용)
# GITHUB_OAUTH_BASE_URL=https://github.com
# GITHUB_API_BASE_URL=https://api.github.com
